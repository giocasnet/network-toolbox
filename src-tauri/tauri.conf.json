{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Network Toolbox",
  "version": "2.3.0",
  "identifier": "it.giocas.nettoolbox",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Network Toolbox",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "publisher": "GioCas",
    "category": "Utility",
    "shortDescription": "Strumenti di diagnostica di rete",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Italian"
        ]
      },
      "wix": {
        "language": "it-IT",
        "upgradeCode": "d720e0fc-fd9e-5e66-be2d-88290ecdff96"
      },
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "certificateThumbprint": null
    },
    "resources": {
      "resources/oui.txt": "oui.txt"
    },
    "copyright": "© 2026 Giorgio Casciola",
    "longDescription": "Strumenti di diagnostica di rete per il reparto IT: ping, traceroute, scansione subnet, rete locale, DNS, porte, whois, blacklist, header HTTP, certificati TLS, email, NTP, SNMP, Wake-on-LAN, generatore di password, convertitore numerico e generatore UUID."
  }
}
